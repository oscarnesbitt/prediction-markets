# .env.example — Copy this to .env and fill in your values.
# .env is gitignored and should never be committed.

# ─── Kalshi API (optional — only needed for order placement) ─────────────────
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=kalshi_private.pem

# ─── Google Sheets (optional — only needed for sheets_sync.py) ───────────────
GOOGLE_CREDENTIALS_PATH=google_credentials.json
SPREADSHEET_ID=your-spreadsheet-id-here
SHEET_TAB_NAME=Kalshi Markets

# ─── Scanner Settings ────────────────────────────────────────────────────────
MARKETS_LIMIT=50
MARKET_STATUS=open
REFRESH_INTERVAL_SECONDS=60

# Minimum 24h volume to show a market. Set to 0 to show all (including dead markets).
MIN_VOLUME_24H=1

# ─── Bayesian Pricer ─────────────────────────────────────────────────────────
EDGE_THRESHOLD=0.05
